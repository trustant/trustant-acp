{
	"name": "trustant-acp",
	"version": "0.11.0",
	"description": "Standalone ACP client — use AI coding agents via the Agent Client Protocol",
	"main": "main.js",
	"scripts": {
		"dev": "bash run.sh",
		"dev:plugin": "node esbuild.config.mjs",
		"setup:agents": "bash setup.sh",
		"serve": "tsx server/index.ts",
		"serve:trureact": "tsx server/index.ts --dir /home/msciab.guest/workbench/trureact/ --port 4097",
		"acp": "tsx server/index.ts --cli",
		"build:web": "node esbuild.web.mjs production",
		"dev:web": "node esbuild.web.mjs",
		"start": "node esbuild.web.mjs production && tsx server/index.ts",
		"build:server": "node esbuild.server.mjs",
		"build": "npm run build:web && npm run build:server",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.css\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.css\"",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"keywords": [],
	"author": "",
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/json": "^0.14.0",
		"@types/node": "^16.11.6",
		"@types/react": "18.3.29",
		"@types/react-dom": "18.3.7",
		"@types/semver": "^7.7.1",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/parser": "^8.0.0",
		"@typescript-eslint/utils": "^8.0.0",
		"esbuild": "0.17.3",
		"eslint": "^9.0.0",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"obsidian": "latest",
		"prettier": "^3.4.2",
		"tslib": "2.4.0",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.0.0",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.28.1",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "^6.35.0",
		"@tanstack/react-virtual": "^3.13.23",
		"diff": "^8.0.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"semver": "^7.7.3",
		"ws": "^8.21.1",
		"zod": "^4.4.3"
	}
}
